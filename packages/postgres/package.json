{
  "name": "@ai-feedback-middleware/postgres",
  "version": "0.3.0-alpha.0",
  "description": "Postgres event store and projection store adapters for ai-feedback-middleware.",
  "license": "Apache-2.0",
  "author": "Babak Abbaschian",
  "homepage": "https://github.com/baabakk/ai-feedback-middleware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baabakk/ai-feedback-middleware.git",
    "directory": "packages/postgres"
  },
  "bugs": {
    "url": "https://github.com/baabakk/ai-feedback-middleware/issues"
  },
  "keywords": [
    "feedback",
    "ai",
    "llm",
    "postgres",
    "event-sourcing"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations": "./migrations/"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-feedback-middleware/core": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@ai-feedback-middleware/adapter-conformance": "workspace:*",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
